---
config:
  layout: elk
---
flowchart TB
  subgraph CAPA_APP["1. Capa de Presentación (Cliente Local)"]
    UI["Interfaz de Prueba Local<br><i>(Open WebUI / CLI / App Prototipo)</i>"]
  end

  subgraph CAPA_ORQ["2. Capa de Orquestación y Contexto (Sin RAG)"]
    ORQ["Gestor de Prompt / Modelfile"]
    KB[("Base de Conocimientos Plana<br><i>(Sílabos, Matrícula, Reglamento en .txt/.md)</i>")]
  end

  subgraph CAPA_CONN["3. Capa de Conectividad (API Local)"]
    API["Servidor Web Local Ollama<br><i>(Endpoints REST / HTTP Streaming / SSE)</i>"]
  end

  subgraph CAPA_INF["4. Capa de Inferencia (Backend / Engine)"]
    LLAMA["Motor llama.cpp<br><i>(Ejecución secuencial / 1 slot activo)</i>"]
    OFFLOAD["Estrategia de Offloading<br><i>(Capas divididas GPU/CPU)</i>"]
    
    subgraph HARDWARE["Aceleración de Cómputo Local"]
      VRAM["GPU Integrada o Dedicada (VRAM)<br><i>(Procesamiento paralelo de tensores)</i>"]
      RAM["CPU / RAM de Sistema<br><i>(Fallback y KV Cache)</i>"]
    end
  end

  subgraph CAPA_STORE["5. Capa de Almacenamiento (Model Storage)"]
    SSD["SSD NVMe Local<br><i>(Modelo Qwen2.5-3B cuantizado Q4_K_M .gguf)</i>"]
  end

  UI -- "1. Envía consulta del alumno/docente" --> ORQ
  KB -- "2. Inyección directa en System Prompt<br>(Context Stuffing)" --> ORQ
  ORQ -- "3. Prompt completo (KB + Consulta)" --> API
  API -- "4. Despacha solicitud al runtime" --> LLAMA
  SSD -. "Carga inicial de pesos (.gguf)" .-> LLAMA
  LLAMA --> OFFLOAD
  OFFLOAD -- "Asigna capas aceleradas" --> VRAM
  OFFLOAD -- "Asigna capas complementarias" --> RAM
  VRAM -- "Cálculo de tokens" --> LLAMA
  RAM -- "Cálculo de tokens" --> LLAMA
  LLAMA -- "5. Transmite tokens generados" --> API
  API -- "6. Respuesta en tiempo real (SSE)" --> UI

  classDef clientStyle fill:#F8FAFC,stroke:#3B82F6,stroke-width:2px,color:#1E293B
  classDef orqStyle fill:#FEF9C3,stroke:#CA8A04,stroke-width:2px,color:#1E293B
  classDef apiStyle fill:#EFF6FF,stroke:#2563EB,stroke-width:2px,color:#1E293B
  classDef engineStyle fill:#F0FDF4,stroke:#16A34A,stroke-width:2px,color:#1E293B
  classDef storageStyle fill:#FEF2F2,stroke:#DC2626,stroke-width:2px,color:#1E293B

  class UI clientStyle
  class ORQ,KB orqStyle
  class API apiStyle
  class LLAMA,OFFLOAD,VRAM,RAM engineStyle
  class SSD storageStyle
